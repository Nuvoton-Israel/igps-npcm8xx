<Bin_Ecc_Map>
	<ImageProperties>
		<BinSize>0</BinSize> <!-- If 0 the binary size will be calculated by the tool -->
		<PadValue>0xFF</PadValue>	<!-- Byte value to pad the empty areas, default is 0 -->
	</ImageProperties>
	<BinField>
		<name>CP1StartTag</name> <!-- name of field -->
		<config>
			<offset>0</offset>           
			<size>4</size> 
		</config>
		<content format='bytes'>0x08 0x50 0x43 0x50</content>  <!-- content the user should fill -->

	</BinField>

	<BinField>
		<name>ExendedAnchor_CrcEn</name>     <!-- DO NOT EDIT. IGPS fills this field automatically according to key_setting_edit_me.json (CRC_Enable). CRC Enabled = 0x1E 0xAB 0xF2 0x57, Disabled = legacy value -->
		<config>
			<offset>0x4</offset>
			<size>4</size>
		</config>
		<content format='bytes'>0x42 0x4F 0x4F 0x54</content>
	</BinField>

	<BinField>
		<!-- Code size -->
		<name>CP1SourceSize</name>         <!-- name of field -->
		<config>
			<offset>8</offset>       
			<size>4</size> 
		</config>
		<content format='FileSize'>inputs/arbel_cp_fw.bin</content>	<!-- content the user should fill -->
	</BinField>
	<BinField>
		<name>CP1_FW</name>             <!-- name of field -->
		<config>
			<offset>16</offset>       
			<size format='FileSize'>inputs/arbel_cp_fw.bin</size>                 <!-- size in the header calculated by tool-->
		</config>
		<content format='FileContent'>inputs/arbel_cp_fw.bin</content>  <!-- content the user should fill -->
	</BinField>	
</Bin_Ecc_Map>
